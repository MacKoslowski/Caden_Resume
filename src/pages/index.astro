---
import BaseLayout from "../layouts/BaseLayout.astro";

import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"
import DriveFiles from '../components/DriveFiles.vue';
const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Caden Koslowski</div>
    <div class="text-3xl py-3 font-bold">Content Writer</div>
    <div class="py-2">
      <text class="text-lg">
        Hello! Chances are that if you are seeing this page I would like to be hired by you! I have 6 months of experience working as a content writer in a business setting, and 2 years of experience writing high quality essays while studying history. In my time as a writer, I have mastered SEO strategy, created editing rubrics, and have experience writing for many different outlets of online media. Overall I can be described as friendly, outgoing, and organized & in my spare time I like to run, make music, and cook! 


      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://www.linkedin.com/in/caden-koslowski" target="_blank"> Let's connect!</a>
    </div>
  </div>
  <DriveFiles client:visible/>
</BaseLayout>
